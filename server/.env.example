# WakePulse Server Environment
# Safe template — no real secrets

NODE_ENV=production

PORT=5000

DOMAIN=your-subdomain.duckdns.org
CLIENT_URL=https://your-subdomain.duckdns.org

# MongoDB Atlas connection string. Allow the VPS public IP in Atlas Network Access.
MONGODB_URI=
MONGODB_DB_NAME=wakepulse

# Use a long, random secret. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP password recovery email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_MAX_CONCURRENCY=5