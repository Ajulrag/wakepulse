# WakePulse Server Environment
# Safe template — no real secrets

NODE_ENV=development

PORT=5000

CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=wakepulse

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP password recovery email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_MAX_CONCURRENCY=5